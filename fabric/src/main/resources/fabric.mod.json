{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "${websiteUrl}",
    "sources": "${sourcesUrl}",
    "issues": "${issueTrackerUrl}"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.cerealcamera.aviator_dream.fabric.AviatorDreamsFabric"
    ],
    "client": [
      "net.cerealcamera.aviator_dream.fabric.AviatorDreamsFabricClient"
    ]
  },
  "mixins": [
    "aviator_dream.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "fabricloader": "${fabricLoaderDependency}",
    "minecraft": "${minecraftDependency}",
    "immersive_aircraft": "${immersiveAircraftDependency}",
    "fabric-api": "${fabricAPIDependency}"
  }
}
